{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++ Build and Run",
            "type": "shell",
            "command": "g++",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Compile and run C++ program",
            "dependsOn": ["Run Executable"]
        },
        {
            "label": "Run Executable",
            "type": "shell",
            "command": "${fileDirname}\\${fileBasenameNoExtension}.exe"
        }
    ]
}
